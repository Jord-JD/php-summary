{
  "name": "jord-jd/php-summary",
  "type": "library",
  "description": "PHP Summarization Library",
  "keywords": [
    "summarizing",
    "summary",
    "summarization",
    "summarization library",
    "library",
    "php"
  ],
  "homepage": "https://github.com/Jord-JD/php-summary",
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^9.6"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\PHPSummary\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\PHPSummary\\Tests\\": "tests/Unit/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "5.x-dev"
    }
  },
  "replace": {
    "divineomega/php-summary": "self.version"
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
